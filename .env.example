# ─────────────────────────────────────────────────────────────────────────────
# Tailscale LLM Proxy Rotator - Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────
PROXY_BIND_HOST=127.0.0.1
PROXY_BIND_PORT=8080

# LLM Provider API URL (OpenAI-compatible)
LLM_PROVIDER_URL=https://api.openai.com/v1

# Request timeout in seconds (shorter = faster failover)
REQUEST_TIMEOUT=25.0

# Maximum retry attempts across nodes
MAX_RETRIES=4

# ─────────────────────────────────────────────────────────────────────────────
# Node Configuration (add as many nodes as needed)
# Format: PROXY_<N>_URL and API_KEY_<N>
# ─────────────────────────────────────────────────────────────────────────────
PROXY_1_URL=socks5h://100.64.0.1:1055
API_KEY_1=sk-proj-your-actual-key-1-here

PROXY_2_URL=socks5h://100.64.0.2:1055
API_KEY_2=sk-proj-your-actual-key-2-here

PROXY_3_URL=socks5h://100.64.0.3:1055
API_KEY_3=sk-proj-your-actual-key-3-here

PROXY_4_URL=socks5h://100.64.0.4:1055
API_KEY_4=sk-proj-your-actual-key-4-here

# Add more nodes if needed:
# PROXY_5_URL=socks5h://100.64.0.5:1055
# API_KEY_5=sk-proj-your-actual-key-5-here

# ─────────────────────────────────────────────────────────────────────────────
# Token Optimization Settings
# ─────────────────────────────────────────────────────────────────────────────
# Enable/disable automatic context compression
ENABLE_CONTEXT_COMPRESSION=true

# Maximum context window size (tokens)
# Set based on your model's limit (e.g., 128000 for GPT-4o)
MAX_CONTEXT_TOKENS=120000

# Reserve tokens for the response to avoid truncation
RESERVED_RESPONSE_TOKENS=4000

# Compression threshold: compress when context is >85% full
COMPRESSION_THRESHOLD=0.85

# Remove duplicate consecutive messages
REMOVE_DUPLICATE_MESSAGES=true

# Strip excessive whitespace from messages
STRIP_WHITESPACE=true

# Default model for token counting (used by tiktoken)
DEFAULT_MODEL=gpt-4o

# ─────────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
