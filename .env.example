# Tailscale LLM Proxy Rotator - Environment Configuration
# Copy this file to .env and customize for your setup

# ─────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────
PROXY_BIND_HOST=127.0.0.1
PROXY_BIND_PORT=8080
LLM_PROVIDER_URL=https://api.openai.com/v1
MAX_RETRIES=4
REQUEST_TIMEOUT=25.0
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# Node Configuration (add as many nodes as needed)
# Format: PROXY_N_URL=socks5h://100.64.x.x:1055
#         API_KEY_N=sk-proj-xxxxx
# ─────────────────────────────────────────────────────────────
PROXY_1_URL=socks5h://100.64.0.1:1055
API_KEY_1=sk-proj-Node1-xxxxxx

PROXY_2_URL=socks5h://100.64.0.2:1055
API_KEY_2=sk-proj-Node2-xxxxxx

PROXY_3_URL=socks5h://100.64.0.3:1055
API_KEY_3=sk-proj-Node3-xxxxxx

PROXY_4_URL=socks5h://100.64.0.4:1055
API_KEY_4=sk-proj-Node4-xxxxxx

# ─────────────────────────────────────────────────────────────
# Token Optimization Pipeline Configuration
# All stages are independently toggleable
# ─────────────────────────────────────────────────────────────

# Master switch for entire optimization pipeline
ENABLE_CONTEXT_COMPRESSION=true

# ── Stage 1: Structural Hygiene (native Python, no dependencies) ──
REMOVE_DUPLICATE_MESSAGES=true
STRIP_WHITESPACE=true

# ── Stage 2: Semantic Compression (requires llmlingua) ──
# Aggressively compresses context while preserving meaning
# Recommended ratio: 0.3-0.7 (lower = more compression)
ENABLE_SEMANTIC_COMPRESSION=false
SEMANTIC_COMPRESSION_RATIO=0.5

# ── Stage 3: Prompt Caching (provider-specific) ──
# Adds cache_control metadata for OpenAI/Anthropic caching APIs
ENABLE_PROMPT_CACHING=false
PROMPT_CACHE_TTL=300

# ── Stage 4: Importance Scoring (Caveman-inspired) ──
# Filters low-importance messages based on recency, role, keywords
ENABLE_IMPORTANCE_SCORING=false
MIN_MESSAGE_IMPORTANCE=0.3

# ── Stage 5: Recursive Summarization ──
# Summarizes old context when approaching token limits
# Note: Production implementation would call LLM API for summarization
ENABLE_RECURSIVE_SUMMARIZATION=false
SUMMARIZATION_MODEL=gpt-4o-mini

# ── Token Limits ──
MAX_CONTEXT_TOKENS=120000
RESERVED_RESPONSE_TOKENS=4000
COMPRESSION_THRESHOLD=0.85

# ── Default Model ──
DEFAULT_MODEL=gpt-4o
