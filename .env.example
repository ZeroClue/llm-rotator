# Tailscale LLM Proxy Rotator - Environment Configuration
# Copy this file to .env and customize for your setup

# ─────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────
PROXY_BIND_HOST=127.0.0.1
PROXY_BIND_PORT=8080
LLM_PROVIDER_URL=https://api.openai.com/v1
MAX_RETRIES=4
REQUEST_TIMEOUT=25.0
# Retry policy for non-idempotent requests: POSTs are retried verbatim on
# failover (429/5xx/timeout). A 504 or timeout may mean the upstream COMPLETED
# — retrying then risks double billing/completions. Set RETRY_POSTS=false to
# give POSTs exactly one attempt (GET/PUT/DELETE/PATCH always fail over).
RETRY_POSTS=true
# Graceful-shutdown drain window (seconds from SIGTERM) for in-flight SSE
# streams: they finish naturally inside it, then get a well-formed terminal
# error event. Keep below GUNICORN_GRACEFUL_TIMEOUT so the event flushes
# before gunicorn's hard kill. 0 cuts streams on the next chunk.
STREAM_DRAIN_WINDOW=20.0
LOG_LEVEL=INFO
# "text" (default) keeps the human format; "json" emits one structured
# object per line with request_id/node_id/outcome fields on lifecycle events.
LOG_FORMAT=text

# Optional bearer-token gate. When set, every /v1/* request must send
# "Authorization: Bearer <token>" or it is rejected with 401 before any
# node is contacted. /health stays open for orchestrators.
# Empty = disabled (no auth).
PROXY_AUTH_TOKEN=

# Persona hygiene: additionally strip client telemetry headers
# (x-stainless-*, x-app, x-title, http-referer) outbound and remove
# provider identity fields (user/metadata/prompt_cache_key/
# safety_identifier) from chat payloads. Off by default while the
# behavior change soaks; the credential/organization header drops
# (x-api-key/api-key/openai-organization/openai-project) are always on
# and unaffected by this flag.
PERSONA_HYGIENE=false

# Retry pacing between failed attempts. A 429/503 Retry-After header is
# honored (capped at RETRY_BACKOFF_MAX) before these apply.
RETRY_BACKOFF_BASE=0.5
RETRY_BACKOFF_MAX=8.0

# Failover ladder (issue #46). ANONYMITY_FAILOVER=same waits out short 429
# Retry-After values on the FAILING persona before allowing a cross-persona
# replay — a byte-identical replay across personas is the cheapest way for
# a provider to link them. "cross" (default) keeps availability-first
# rotation. Applies to 429s only; timeout/5xx keep RETRY_POSTS semantics.
ANONYMITY_FAILOVER=cross
FAILOVER_MAX_WAIT=8.0
# Cap on threads concurrently parked in same-persona waits (burst of 429s
# must not pin the whole gthread pool).
FAILOVER_MAX_WAITERS=4
# Re-serialize JSON per attempt with varied framing (semantically identical,
# byte-different) so replays never carry identical bytes.
REDISTRIBUTION_JITTER=true

# Per-node cooldown after a failure (exponential in consecutive failures,
# capped at NODE_COOLDOWN_MAX). Cooling nodes are skipped by the round-robin.
NODE_COOLDOWN_BASE=2.0
NODE_COOLDOWN_MAX=60.0

# ─────────────────────────────────────────────────────────────
# Node Configuration (add as many nodes as needed)
# Format: PROXY_N_URL=socks5h://100.64.x.x:1055
#         API_KEY_N=sk-proj-xxxxx
# Optional persona overrides (ADR 0002): each node presents one consistent
# client identity; defaults derive deterministically from the node index.
# PERSONA_N_USER_AGENT=undici/6.19.2
# PERSONA_N_FINGERPRINT=undici-node20-linux
# ─────────────────────────────────────────────────────────────
PROXY_1_URL=socks5h://100.64.0.1:1055
API_KEY_1=sk-proj-Node1-xxxxxx

PROXY_2_URL=socks5h://100.64.0.2:1055
API_KEY_2=sk-proj-Node2-xxxxxx

PROXY_3_URL=socks5h://100.64.0.3:1055
API_KEY_3=sk-proj-Node3-xxxxxx

PROXY_4_URL=socks5h://100.64.0.4:1055
API_KEY_4=sk-proj-Node4-xxxxxx

# ─────────────────────────────────────────────────────────────
# Token Optimization Pipeline Configuration
# All stages are independently toggleable
# ─────────────────────────────────────────────────────────────

# Master switch for entire optimization pipeline
ENABLE_CONTEXT_COMPRESSION=true

# Provider profile presets the context budget:
#   openai (128k/4k) | anthropic (200k/8k) | groq (32k/2k)
PROVIDER_PROFILE=openai

# Streaming requests skip expensive stages (hygiene only)
ENABLE_STREAMING_FASTPATH=true

# ── Stage 1: Structural Hygiene (native Python, no dependencies) ──
REMOVE_DUPLICATE_MESSAGES=true
STRIP_WHITESPACE=true

# ── Stage 2: Semantic Compression (requires llmlingua) ──
# Aggressively compresses context while preserving meaning
# Recommended ratio: 0.3-0.7 (lower = more compression)
ENABLE_SEMANTIC_COMPRESSION=false
SEMANTIC_COMPRESSION_RATIO=0.5

# ── Stage 3: Prompt Caching ──
# Injects Anthropic-style cache_control markers into content parts.
# NEVER on by default: OpenAI's Chat Completions API caches automatically
# and rejects unknown fields, so enable only for Anthropic-compatible targets.
ENABLE_PROMPT_CACHING=false

# ── Stage 4: Importance Scoring (Caveman-inspired) ──
# Filters low-importance messages based on recency, role, keywords
ENABLE_IMPORTANCE_SCORING=false
MIN_MESSAGE_IMPORTANCE=0.3

# ── Stage 5: Recursive Summarization ──
# Summarizes old context when approaching token limits
# Note: Production implementation would call LLM API for summarization
ENABLE_RECURSIVE_SUMMARIZATION=false
SUMMARIZATION_MODEL=gpt-4o-mini

# ── Token Limits ──
# Leave commented to use the PROVIDER_PROFILE budget; explicit values win.
# MAX_CONTEXT_TOKENS=128000
# RESERVED_RESPONSE_TOKENS=4096
COMPRESSION_THRESHOLD=0.85

# ── Default Model ──
DEFAULT_MODEL=gpt-4o
