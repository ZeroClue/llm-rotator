[Unit]
Description=Secure LLM Proxy Rotator with Tailscale Integration
Documentation=https://github.com/your-org/llm-proxy-rotator
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
User=your-username
Group=your-username
WorkingDirectory=/opt/llm-rotator
ExecStart=/usr/bin/python3 /opt/llm-rotator/rotator.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-rotator

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/log/llm-rotator

# Node configuration is mandatory (PROXY_1_URL / API_KEY_1 at minimum).
# Put it in an environment file the daemon can read, e.g. /etc/llm-rotator.env:
#   LLM_PROVIDER_URL=https://api.openai.com/v1
#   PROXY_1_URL=socks5h://100.64.0.1:1055
#   API_KEY_1=sk-proj-xxxxx
EnvironmentFile=-/etc/llm-rotator.env

# Environment variables (optional - override defaults)
Environment="LLM_PROVIDER_URL=https://api.openai.com/v1"
Environment="PROXY_BIND_PORT=8080"
Environment="MAX_RETRIES=4"

[Install]
WantedBy=multi-user.target
